<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- Avatar -->
        <ImageView
            android:id="@+id/imgAvatar"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="32dp"
            android:src="@drawable/ic_avatar"
            android:background="@drawable/bg_avatar_circle"
            android:padding="8dp"
            android:contentDescription="Avatar" />

        <!-- Tên sinh viên -->
        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/main_subtitle"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/colorPrimary"
            android:layout_marginTop="12dp" />

        <!-- Tên ứng dụng -->
        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/main_title"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextPrimary"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="32dp" />

        <!-- Nút BMI -->
        <Button
            android:id="@+id/btnBmi"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/btn_bmi"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button_bmi"
            android:layout_marginBottom="12dp" />

        <!-- Nút Món ăn -->
        <Button
            android:id="@+id/btnMonAn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/btn_mon_an"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button_mon_an"
            android:layout_marginBottom="12dp" />

        <!-- Nút Bài thuốc -->
        <Button
            android:id="@+id/btnBaiThuoc"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/btn_bai_thuoc"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button_bai_thuoc"
            android:layout_marginBottom="12dp" />

        <!-- Nút Giới thiệu -->
        <Button
            android:id="@+id/btnGioiThieu"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/btn_gioi_thieu"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button_gioi_thieu"
            android:layout_marginBottom="12dp" />

        <!-- Nút Làm thêm -->
        <Button
            android:id="@+id/btnLamThem"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/btn_lam_them"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button_lam_them"
            android:layout_marginBottom="24dp" />

    </LinearLayout>
</ScrollView>