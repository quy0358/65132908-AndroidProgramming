<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Tiêu đề -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📋 Thông Tin Sinh Viên"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#1565C0"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp" />

        <!-- Ảnh sinh viên -->
        <ImageView
            android:id="@+id/imgSinhVien"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:scaleType="centerCrop"
            android:src="@drawable/anh_sinh_vien"
            android:contentDescription="Ảnh sinh viên"
            android:layout_marginBottom="24dp" />

        <!-- Họ và Tên -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            android:background="#F5F5F5">

            <TextView
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:text="Họ và Tên:"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333333" />

            <TextView
                android:id="@+id/txtHoTen"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Nguyễn Thành Quý"
                android:textSize="16sp"
                android:textColor="#1565C0"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Mã số sinh viên -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            android:background="#FFFFFF">

            <TextView
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:text="Mã số SV:"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333333" />

            <TextView
                android:id="@+id/txtMaSo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="65132908"
                android:textSize="16sp"
                android:textColor="#555555" />
        </LinearLayout>

        <!-- Tên lớp -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            android:background="#F5F5F5">

            <TextView
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:text="Tên lớp:"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333333" />

            <TextView
                android:id="@+id/txtTenLop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="65-CNTT-2"
                android:textSize="16sp"
                android:textColor="#555555" />
        </LinearLayout>

        <!-- Địa chỉ thường trú -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            android:background="#FFFFFF">

            <TextView
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:text="Địa chỉ:"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333333" />

            <TextView
                android:id="@+id/txtDiaChi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TP. Nha Trang"
                android:textSize="16sp"
                android:textColor="#555555" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
