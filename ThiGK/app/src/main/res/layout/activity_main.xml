<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    tools:context=".MainActivity">

    <!-- Phần header: ảnh bác sĩ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:background="@color/mau_nen_header"
        android:padding="16dp">

        <ImageView
            android:id="@+id/anhBacSi"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:src="@drawable/ic_bac_si"
            android:contentDescription="Ảnh bác sĩ" />
    </LinearLayout>

    <!-- Phần nội dung: tên + các nút -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Cột bên trái: tên bác sĩ -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTenBacSi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ten_bac_si"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/mau_chu_chinh" />
        </LinearLayout>

        <!-- Cột bên phải: các nút chức năng -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <!-- Nút BMI -->
            <Button
                android:id="@+id/nutBmi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/hinh_nen_nut"
                android:text="@string/nut_bmi"
                android:textColor="@color/mau_chu_chinh"
                android:textSize="16sp"
                android:padding="12dp" />

            <!-- Nút Món ăn -->
            <Button
                android:id="@+id/nutMonAn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/hinh_nen_nut"
                android:text="@string/nut_mon_an"
                android:textColor="@color/mau_chu_chinh"
                android:textSize="16sp"
                android:padding="12dp" />

            <!-- Nút Bài thuốc -->
            <Button
                android:id="@+id/nutBaiThuoc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/hinh_nen_nut"
                android:text="@string/nut_bai_thuoc"
                android:textColor="@color/mau_chu_chinh"
                android:textSize="16sp"
                android:padding="12dp" />

            <!-- Nút Giới thiệu -->
            <Button
                android:id="@+id/nutGioiThieu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/hinh_nen_nut"
                android:text="@string/nut_gioi_thieu"
                android:textColor="@color/mau_chu_chinh"
                android:textSize="16sp"
                android:padding="12dp" />

            <!-- Nút Làm thêm -->
            <Button
                android:id="@+id/nutLamThem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/hinh_nen_nut"
                android:text="@string/nut_lam_them"
                android:textColor="@color/mau_chu_chinh"
                android:textSize="16sp"
                android:padding="12dp" />

        </LinearLayout>
    </LinearLayout>

</LinearLayout>