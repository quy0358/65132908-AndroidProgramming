<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainChiTietBai"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    tools:context=".ChiTietBaiActivity">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/mau_nen_header"
        android:padding="12dp">

        <ImageView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/ic_bac_si"
            android:contentDescription="Ảnh bác sĩ" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Chi tiết bài thuốc"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/mau_chu_chinh"
            android:gravity="center"
            android:padding="8dp" />
    </LinearLayout>

    <!-- Nội dung chi tiết -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Ảnh đại diện -->
        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_bai_thuoc"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp"
            android:contentDescription="Ảnh bài thuốc" />

        <!-- Tên bài thuốc -->
        <TextView
            android:id="@+id/tvTenBaiThuocChiTiet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/mau_xanh_dam"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- Thời gian -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thời gian:"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/mau_chu_chinh"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvThoiGianChiTiet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textColor="@color/mau_chu_phu"
            android:layout_marginBottom="16dp" />

        <!-- Mô tả -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mô tả:"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/mau_chu_chinh"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvMoTaChiTiet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textColor="@color/mau_chu_phu"
            android:layout_marginBottom="16dp" />

        <!-- Thành phần -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thành phần:"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/mau_chu_chinh"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvThanhPhanChiTiet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textColor="@color/mau_chu_phu"
            android:layout_marginBottom="16dp" />

        <!-- Cách dùng -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cách dùng:"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/mau_chu_chinh"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvCachDungChiTiet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textColor="@color/mau_chu_phu" />

    </LinearLayout>

</LinearLayout>
