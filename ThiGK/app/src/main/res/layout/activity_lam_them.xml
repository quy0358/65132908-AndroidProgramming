<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainLamThem"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5"
    tools:context=".LamThemActivity">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/mau_nen_header"
        android:padding="12dp">

        <ImageView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/ic_bac_si"
            android:contentDescription="Ảnh bác sĩ" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tieu_de_tin_tuc"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/mau_chu_chinh"
            android:gravity="center"
            android:padding="8dp" />
    </LinearLayout>

    <!-- RecyclerView hiển thị danh sách tin tức -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewTinTuc"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

    <!-- Thanh tải dữ liệu -->
    <ProgressBar
        android:id="@+id/thanhTaiDuLieu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

</LinearLayout>
