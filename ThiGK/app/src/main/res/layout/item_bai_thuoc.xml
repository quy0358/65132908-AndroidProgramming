<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="10dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/hinh_nen_edittext">

    <!-- Ảnh đại diện bài thuốc -->
    <ImageView
        android:id="@+id/imgBaiThuoc"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@drawable/ic_bai_thuoc"
        android:scaleType="centerCrop"
        android:contentDescription="Ảnh bài thuốc"
        android:layout_marginEnd="12dp" />

    <!-- Tên bài thuốc -->
    <TextView
        android:id="@+id/tvTenBaiThuoc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="16sp"
        android:textColor="@color/mau_chu_chinh"
        android:textStyle="bold"
        android:layout_marginEnd="8dp" />

    <!-- Thời gian -->
    <TextView
        android:id="@+id/tvThoiGian"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="@color/mau_chu_phu" />

</LinearLayout>
