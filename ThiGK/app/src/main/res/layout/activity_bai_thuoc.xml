<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainBaiThuoc"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    tools:context=".BaiThuocActivity">

    <!-- Header: ảnh bác sĩ + tiêu đề -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/mau_nen_header"
        android:padding="12dp">

        <ImageView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/ic_bac_si"
            android:contentDescription="Ảnh bác sĩ" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Các bài thuốc"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/mau_chu_chinh"
            android:gravity="center"
            android:padding="8dp" />
    </LinearLayout>

    <!-- Danh sách bài thuốc bằng RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDanhSachBaiThuoc"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="8dp"
        android:clipToPadding="false" />

</LinearLayout>
